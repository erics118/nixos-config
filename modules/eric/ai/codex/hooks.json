{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.agents/hooks/git-add-before-nix.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-global-search.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-symlink-clobber.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-agent-commit.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-agent-push.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-git-config-edit.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-shell-edit.sh\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/block-sudo-probe.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.agents/hooks/tmux-agent-resume.sh\" codex",
            "type": "command"
          },
          {
            "command": "bash '/Users/eric/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.agents/hooks/tmux-bell.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
