{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.agents/hooks/guard.sh\" pre codex",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.agents/hooks/tmux-agent-resume.sh\" codex",
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.agents/hooks/tmux-bell.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
