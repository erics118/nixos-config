# Read-only inspection commands are safe to run without an extra approval.
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["df"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["fd"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["less"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["readlink"], decision="allow")
prefix_rule(pattern=["realpath"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["scc"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["tr"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")

# Keep only read-only git operations outside the sandbox.
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")

# Keep read-only Nix metadata and lookup commands outside the sandbox.
prefix_rule(pattern=["nix", "eval"], decision="allow")
prefix_rule(pattern=["nix", "flake", "metadata"], decision="allow")
prefix_rule(pattern=["nix", "flake", "show"], decision="allow")
prefix_rule(pattern=["nix", "path-info"], decision="allow")
prefix_rule(pattern=["nix", "search"], decision="allow")
prefix_rule(pattern=["nix-store", "-q"], decision="allow")

# Allow normal project workflows to access the store without a prompt.
prefix_rule(pattern=["direnv", "allow"], decision="allow")
prefix_rule(pattern=["just", "build"], decision="allow")
prefix_rule(pattern=["just", "check"], decision="allow")
prefix_rule(pattern=["just", "fmt"], decision="allow")
prefix_rule(pattern=["nix", "build"], decision="allow")
prefix_rule(pattern=["nix", "develop"], decision="allow")
prefix_rule(pattern=["nix", "flake", "check"], decision="allow")
