{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3560,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "10000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/nixos-config/modules/eric/ai/claude/mods/tex-math",
    "ENABLE_TOOL_SEARCH": "auto",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "gpg.ssh.program",
    "GIT_CONFIG_VALUE_0": "ssh-keygen",
    "GIT_CONFIG_KEY_1": "core.sshCommand",
    "GIT_CONFIG_VALUE_1": "ssh -o IdentityAgent=none -i ~/.ssh/id_ed25519_github_erics118 -i ~/.ssh/id_ed25519_cornell"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cut *)",
      "Bash(df *)",
      "Bash(dune:*)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(jq *)",
      "Bash(less *)",
      "Bash(ocamlfind:*)",
      "Bash(ocamlmerlin:*)",
      "Bash(pwd *)",
      "Bash(rg *)",
      "Bash(scc *)",
      "Bash(sort *)",
      "Bash(tr *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(xargs cat *)",
      "Bash(xargs ls *)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run start:*)",
      "mcp__ide__getDiagnostics",
      "mcp__context7__*",
      "Edit(~/.eric/**)",
      "Bash(nix-store -q *)",
      "Bash(nix path-info *)",
      "Bash(nix flake metadata *)",
      "Bash(nix flake show *)",
      "Bash(nix eval *)",
      "Bash(nix search *)",
      "Bash(direnv allow *)",
      "Bash(git add *)",
      "Bash(just build*)",
      "Bash(just check*)",
      "Bash(just fmt*)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(du *)",
      "Bash(grep *)",
      "Bash(date *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(nix build *)",
      "Bash(nix flake check *)",
      "Bash(gh api *)",
      "Bash(gh search *)",
      "Bash(gh status *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(tmux -L *)",
      "Bash(ntfy pub *)",
      "Bash(sketchybar --set apple *)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "SendUserFile"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/guard.sh\" pre claude || { echo 'guard hook did not run, so the call was not checked' >&2; exit 2; }",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/guard.sh\" post claude; s=$?; [ $s -eq 0 ] || [ $s -eq 2 ] || { echo 'guard hook did not run, so the edit was not checked' >&2; exit 2; }; exit $s"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/tmux-bell.sh\""
          },
          {
            "type": "prompt",
            "model": "claude-haiku-5-5",
            "timeout": 30,
            "prompt": "The agent may stop when its final message to the user (last_assistant_message in the input) passes this check.\n\nIt passes when any one of these holds:\n- it makes no claim that a change is fixed, works, is verified, is live, or is done (questions, proposals, plans, explanations, and promises of later work pass);\n- it names a check that exercised the end result: running the changed program or command and seeing the right behavior, reproducing the original symptom and seeing it gone, or a test that covers that exact behavior;\n- the change only touches prose (notes, docs, memory files, comments) and the transcript shows the changed text read back, or the paths and links it names checked to exist. For prose the text is the end result, and how a later session loads or uses it is out of scope;\n- it clearly says what is untested;\n- stop_hook_active is true in the input.\n\nIt fails only when it claims a change is fixed, works, is verified, is live, or is done, and nothing in the transcript shows a check that exercised the end result. A build, type-check, lint, an unrelated test, reading the code, a restart with no look at the result, or \"should work\" is not such a check.\n\nAnswer ok=true when it passes. Answer ok=false when it fails, with a reason that names the unchecked claim.\n\nInput: $ARGUMENTS"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/tmux-bell.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/tmux-agent-resume.sh\" claude"
          },
          {
            "type": "command",
            "command": "bash -c 'm=$(jq -r \".hooks[][].hooks[].command\" \"$HOME/.claude/settings.json\" | grep -o \"\\$HOME/\\.agents/hooks/[^\\\" ]*\" | sort -u | while read -r p; do f=$HOME${p#\\$HOME}; [ -x \"$f\" ] || printf \"%s \" \"$f\"; done); [ -z \"$m\" ] || jq -n --arg m \"guard hooks missing, so they do not run: $m\" \"{systemMessage:\\$m,hookSpecificOutput:{hookEventName:\\\"SessionStart\\\",additionalContext:\\$m}}\"'"
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/reminders.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'command -v rexume >/dev/null || exit 0; exec rexume report claude'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "zsh -f ~/.claude/statusline.zsh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "agent-orchestration@claude-code-workflows": false,
    "cicd-automation@claude-code-workflows": false,
    "ralph-loop@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "impeccable@impeccable": false,
    "skill-creator@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "railway@claude-plugins-official": false,
    "notion@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 800000
    }
  },
  "advisorModel": "fable",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppuccin-mocha",
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "In /Users/eric/dev/resume, running the applying-to-jobs CLI (node .../applying-to-jobs/src/cli.ts) to submit job applications (submit, apply --submit, batch --submit) is authorized when the user asked in this session to submit them, and so is reading the receipt folders it writes."
    ]
  }
}
