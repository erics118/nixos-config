{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3560,
  "env": {
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(dune:*)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(find:*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(less *)",
      "Bash(ls *)",
      "Bash(nix develop:*)",
      "Bash(ocamlfind:*)",
      "Bash(ocamlmerlin:*)",
      "Bash(pwd *)",
      "Bash(rg *)",
      "Bash(scc *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which:*)",
      "Bash(xargs cat *)",
      "Bash(xargs ls *)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run start:*)",
      "mcp__ide__getDiagnostics",
      "mcp__context7__*",
      "mcp__plugin_context7_context7__*",
      "Bash(nix-store -q *)",
      "Bash(nix path-info *)",
      "Bash(nix flake metadata *)",
      "Bash(nix flake show *)",
      "Bash(nix eval *)",
      "Bash(nix search *)",
      "Bash(direnv exec *)",
      "Bash(direnv allow *)",
      "Bash(git add *)",
      "Bash(just build*)",
      "Bash(just check*)",
      "Bash(just fmt*)",
      "Bash(readlink *)",
      "Bash(realpath *)"
    ],
    "deny": ["EnterPlanMode", "ExitPlanMode"],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/deny-symlink-path.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-smart-punct.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-git-config-edit.sh\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-write-tracked.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/git-add-before-nix.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/strip-claude-attribution.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-global-search.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-symlink-clobber.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/ask-dangerous-git.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-agent-commit.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-agent-push.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-git-config-edit.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-shell-edit.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-sudo-probe.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/treefmt-on-edit.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/warn-comment-block.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/caps-led.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/caps-led.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "agent-orchestration@claude-code-workflows": false,
    "cicd-automation@claude-code-workflows": false,
    "ralph-loop@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "impeccable@impeccable": false,
    "skill-creator@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "railway@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
