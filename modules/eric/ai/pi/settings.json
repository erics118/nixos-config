{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "tuiMode": "fullscreen",
  "shellPath": "/run/current-system/sw/bin/bash",
  "quietStartup": true,
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "showHardwareCursor": true,
  "editorPaddingX": 2,
  "outputPad": 1,
  "enabledModels": ["openai/*", "openai-codex/*", "openrouter/*"],
  "packages": [
    "npm:pi-web-access@0.34.0",
    "git:github.com/erics118/pi-hermes-memory",
    "npm:pi-subagents@0.76.1",
    "git:github.com/erics118/pi-diff"
  ],
  "subagents": {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-terra",
    "agentOverrides": {
      "oracle": {
        "model": "gpt-6.1-sol",
        "thinking": "high",
        "inheritGlobalContext": true,
        "inheritSkills": true
      },
      "reviewer": {
        "model": "gpt-6.1-sol",
        "thinking": "high",
        "inheritGlobalContext": true,
        "inheritSkills": true
      },
      "scout": {
        "inheritGlobalContext": true,
        "inheritSkills": true
      },
      "researcher": {
        "inheritGlobalContext": true,
        "inheritSkills": true
      },
      "evidence-auditor": {
        "inheritGlobalContext": true,
        "inheritSkills": true
      },
      "worker": {
        "inheritGlobalContext": true,
        "inheritSkills": true
      }
    }
  },
  "lastChangelogVersion": "1.1.0",
  "theme": "catppuccin-mocha",
  "modelThinkingLevels": {
    "openai/gpt-5.6-terra": "medium"
  }
}
