{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "tuiMode": "fullscreen",
  "shellPath": "/run/current-system/sw/bin/bash",
  "quietStartup": true,
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "showHardwareCursor": true,
  "editorPaddingX": 2,
  "outputPad": 1,
  "enabledModels": ["openai/*", "openai-codex/*", "openrouter/*"],
  "packages": [
    "npm:pi-web-access@0.34.0",
    "git:github.com/erics118/pi-hermes-memory",
    "npm:pi-subagents@0.73.1",
    "git:github.com/erics118/pi-diff"
  ],
  "subagents": {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-terra",
    "agentOverrides": {
      "oracle": {
        "model": "gpt-5.6-sol",
        "thinking": "high"
      },
      "reviewer": {
        "model": "gpt-5.6-sol",
        "thinking": "high"
      }
    }
  },
  "pi-fork": {
    "defaultEffort": "balanced",
    "effortProfiles": {
      "deep": {
        "provider": "openai",
        "id": "gpt-5.6-sol",
        "thinking": "high"
      }
    }
  },
  "lastChangelogVersion": "1.0.2",
  "theme": "catppuccin-mocha",
  "modelThinkingLevels": {
    "openai/gpt-5.6-terra": "medium"
  }
}
