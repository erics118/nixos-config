#!/usr/bin/env bash
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: brief PLAN_FILE TASK_NUMBER" >&2; exit 2; }
plan=$1 n=$2
[ -f "$plan" ] || { echo "no such plan: $plan" >&2; exit 2; }
dir="$(git rev-parse --show-toplevel)/.eric/plans/$(basename "$plan" .md)"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
out="$dir/task-$n-brief.md"
awk -v n="$n" '
  /^```/ { fence = !fence }
  !fence && /^#+[ \t]+Task[ \t]+[0-9]+/ { in_task = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) }
  in_task { print }
' "$plan" > "$out"
[ -s "$out" ] || { echo "task $n not found in $plan" >&2; exit 3; }
echo "$out"
