                :firefox ["^org\\.mozilla\\.firefox(developeredition)?$"]
                :wezterm ["^com\\.github\\.wez\\.wezterm$"]
                :orion ["^com\\.kagi\\.kagimacOS\\.RC$"]
                :coding ["^com\\.microsoft\\.VSCode$" "^com\\.jetbrains\\..*$" "^com\\.todesktop\\..*$"]

                ;; :fn_mods_apps ["^com.jetbrains\\..*$" "^com.parallels.desktop.console$" "^com\\.microsoft\\.VSCode$"]
