{:profiles {:Default {:sim 70 ;; basic.simultaneous_threshold_milliseconds
                      :delay 500 ;; basic.to_delayed_action_delay_milliseconds
                      :alone 300 ;; basic.to_if_alone_timeout_milliseconds
                      :held 500 ;; basic.to_if_held_down_threshold_milliseconds
                      :default true}}

 :applications {:chrome ["^com\\.google\\.Chrome$"]
