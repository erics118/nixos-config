  {:des "finger function: 1finger-[f1-f12] to custom keys"
   :rules [
           [:#Pf1 :display_brightness_decrement ["multitouch_extension_finger_count_total" 1]]
           [:#Pf2 :display_brightness_increment ["multitouch_extension_finger_count_total" 1]]

           [:!S#Pf1 :!OSdisplay_brightness_decrement ["multitouch_extension_finger_count_total" 1]]
           [:!S#Pf2 :!OSdisplay_brightness_increment ["multitouch_extension_finger_count_total" 1]]

           [:!C#Pf1 :illumination_decrement ["multitouch_extension_finger_count_total" 1]]
           [:!C#Pf2 :illumination_increment ["multitouch_extension_finger_count_total" 1]]

           [:!SC#Pf1 :!OSillumination_decrement ["multitouch_extension_finger_count_total" 1]]
           [:!S#Pf2 :!OSillumination_increment ["multitouch_extension_finger_count_total" 1]]

           [:#Pf3 :mission_control ["multitouch_extension_finger_count_total" 1]]
           [:f4 :launchpad ["multitouch_extension_finger_count_total" 1]]
           [:f5 :vk_none ["multitouch_extension_finger_count_total" 1]]
           [:f6 :illumination_increment ["multitouch_extension_finger_count_total" 1]]

           [:#Pf7 :rewind ["multitouch_extension_finger_count_total" 1]]
           [:#Pf8 :play_or_pause ["multitouch_extension_finger_count_total" 1]]
           [:#Pf9 :fast_forward ["multitouch_extension_finger_count_total" 1]]
           [:#Pf10 :mute ["multitouch_extension_finger_count_total" 1]]
           [:#Pf11 :volume_decrement ["multitouch_extension_finger_count_total" 1]]
           [:#Pf12 :volume_increment ["multitouch_extension_finger_count_total" 1]]]}

  {:des "firefox: ctrl-tab -> alt-pagedown, ctrl-shift-tab -> alt-pageup, swap cmd-shift-enter and cmd-enter"
   :rules [[:!Ttab :!TOpage_down :firefox]
           [:!STtab :!TOpage_up :firefox]
           ; [:!Creturn_or_enter :!CSreturn_or_enter :firefox]
           ; [:!CSreturn_or_enter :!Creturn_or_enter :firefox]
]
}

  {:des "latex: in vscode: rcmd -> $, ralt -> _, lshift -> (, rshift -> )"
   :rules [[:right_command :right_command :vscode {:alone :!S4 :delayed {:invoked :vk_none}}]
           [:right_option :right_option :vscode {:alone :!Shyphen :delayed {:invoked :vk_none}}]

           [:left_shift :left_shift :vscode {:alone :!S9 :delayed {:invoked :vk_none}}]
           [:right_shift :right_shift :vscode {:alone :!S0 :delayed {:invoked :vk_none}}]
           ]}

