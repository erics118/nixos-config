 :main
 [{:des "hyper key: caps_lock to hyper, hyper-tab to caps_lock"
   :rules [[:##caps_lock :!QWEright_shift nil
            {:alone :escape
             :delayed {:canceled :vk_none}}]
           [:!!##tab :caps_lock]]}

;;   ;; ralt-l to lock screen
;;   {:des "right_option+l to lock screen"
;;    :rules [;;    [:!El :!CTq]
;;            [:!El "pmset displaysleepnow"]]}

  ;; use caps_lock for escape
  {:des "escape to vk_none"
   :rules [[:##escape :vk_none]]}

  {:des "disable annoying shortcuts: hyper+comma to none"
   :rules [[:!!##comma :vk_none]
           [:!!##period :vk_none]]}

  {:des "hyper navigation: hyper-(any-)hjkl to (any-)arrows)"
   :rules [[:!!##h :left_arrow]
           [:!!##j :down_arrow]
           [:!!##k :up_arrow]
           [:!!##l :right_arrow]]}

