#compdef rtmux

# hosts come from ssh config aliases, sessions from the remote tmux server
# the remote lookup is cheap because ssh multiplexing reuses the open connection

_rtmux_hosts() {
  awk '$1 == "Host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' \
    ~/.ssh/config ~/.ssh/config.local 2>/dev/null | sort -u
}

_rtmux_sessions() {
  ssh -o BatchMode=yes -o ConnectTimeout=2 "$1" tmux ls 2>/dev/null | cut -d: -f1
}

_rtmux() {
  local state
  local -a line

  _arguments -C \
    '(-a --autossh)'{-a,--autossh}'[fall back to autossh]' \
    '1:host:->host' \
    '2:session:->session'

  case $state in
  host)
    local -a hosts
    hosts=(${(f)"$(_rtmux_hosts)"})
    _describe -t hosts 'host' hosts
    ;;
  session)
    local -a sessions modes
    sessions=(${(f)"$(_rtmux_sessions "${line[1]}")"})
    (( $#sessions )) && _describe -t sessions 'session' sessions
    modes=('--ls:list sessions on the host')
    _describe -t modes 'mode' modes
    ;;
  esac
}

_rtmux "$@"
