#compdef rtmux

# hosts come from `rtmux --hosts`, the same list its picker shows. sessions come
# from `rtmux HOST --ls`, cheap because ssh multiplexing reuses the connection

_rtmux_sessions() {
  rtmux "$1" --ls 2>/dev/null | cut -f1
}

_rtmux() {
  local state
  local -a line

  _arguments -C \
    '(-a --autossh)'{-a,--autossh}'[force autossh]' \
    '1:host:->host' \
    '2:session:->session'

  case $state in
  host)
    local -a hosts
    hosts=(${(f)"$(rtmux --hosts)"})
    _describe -t hosts 'host' hosts
    ;;
  session)
    local -a sessions modes
    sessions=(${(f)"$(_rtmux_sessions "${line[1]}")"})
    (( $#sessions )) && _describe -t sessions 'session' sessions
    modes=('--ls:list sessions on the host' '--uninstall:remove the private tmux server and files rtmux installed')
    _describe -t modes 'mode' modes
    ;;
  esac
}

_rtmux "$@"
