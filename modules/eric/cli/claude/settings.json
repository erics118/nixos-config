{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(dune:*)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(find:*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(less *)",
      "Bash(ls *)",
      "Bash(nix develop:*)",
      "Bash(ocamlfind:*)",
      "Bash(ocamlmerlin:*)",
      "Bash(pwd *)",
      "Bash(rg *)",
      "Bash(scc *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which:*)",
      "Bash(xargs cat *)",
      "Bash(xargs ls *)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run start:*)",
      "mcp__ide__getDiagnostics",
      "mcp__context7__*",
      "mcp__plugin_context7_context7__*",
      "Bash(nix-store -q *)",
      "Bash(nix path-info *)",
      "Bash(nix flake metadata *)",
      "Bash(nix flake show *)",
      "Bash(nix eval *)",
      "Bash(nix search *)",
      "Bash(git -C * log *)",
      "Bash(git -C * show *)",
      "Bash(git -C * rev-parse *)",
      "Bash(direnv exec *)",
      "Bash(direnv allow *)",
      "Bash(git add *)",
      "Bash(just build*)",
      "Bash(just check*)",
      "Bash(just fmt*)",
      "Bash(readlink *)",
      "Bash(realpath *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/resolve-symlink-path.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/git-add-before-nix.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/strip-claude-attribution.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/treefmt-on-edit.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "agent-orchestration@claude-code-workflows": false,
    "cicd-automation@claude-code-workflows": false,
    "ralph-loop@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "impeccable@impeccable": false,
    "skill-creator@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "railway@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "verbose": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
